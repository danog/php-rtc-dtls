{
    "name": "danog/php-rtc-dtls",
    "type": "library",
    "description": "A PHP implementation of Datagram Transport Layer Security (DTLS), designed for secure communication over UDP, especially in real-time communication protocols such as WebRTC and SRTP. Fork with FFI made optional and a pure-PHP DTLS/SRTP stack, maintained for MadelineProto.",
    "keywords": [
        "rtp",
        "dtls"
    ],
    "homepage": "https://www.quasarstream.com/webrtc",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community",
            "homepage": "https://quasarstream.com/teams"
        }
    ],
    "require": {
        "php": "^8.4",
        "quasarstream/exception": "^1.0",
        "quasarstream/ice": "^1.0",
        "quasarstream/rtp": "^1.0",
        "quasarstream/sctp": "^1.0",
        "quasarstream/stats": "^1.0",
        "quasarstream/sdp": "^1.0",
        "quasarstream/ssl": "^1.0",
        "quasarstream/srtp": "^1.0",
        "evenement/evenement": "^3.0"
    },
    "require-dev": {
        "phpunit/php-code-coverage": "11.0.x-dev",
        "phpunit/phpunit": "^11.3"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\DTLS\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webrtc\\DTLS\\": "tests"
        }
    },
    "minimum-stability": "dev",
    "replace": {
        "quasarstream/dtls": "self.version"
    }
}
