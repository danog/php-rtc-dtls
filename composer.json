{
    "name": "danog/php-rtc-dtls",
    "type": "library",
    "description": "Pure-PHP DTLS 1.2 for WebRTC, powered by phpseclib and Amp v3.",
    "keywords": [
        "rtp",
        "dtls",
        "ssl",
        "crypto",
        "openssl",
        "x509",
        "certificate",
        "privatekey"
    ],
    "homepage": "https://github.com/danog/php-rtc-dtls",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community"
        },
        {
            "name": "Daniil Gentili",
            "email": "daniil@daniil.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "amphp/amp": "^3.1",
        "danog/php-rtc-exception": "^1.0",
        "danog/php-rtc-ice": "^1.0",
        "danog/php-rtc-rtp": "^1.0",
        "danog/php-rtc-sctp": "^1.0",
        "danog/php-rtc-stats": "^1.0",
        "danog/php-rtc-sdp": "^1.0",
        "danog/php-rtc-mixin": "^1.0",
        "danog/php-rtc-srtp": "^1.0",
        "evenement/evenement": "^3.0",
        "symfony/polyfill-php84": "^1.32",
        "phpseclib/phpseclib": "^3.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.0"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\DTLS\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webrtc\\DTLS\\": "tests"
        }
    },
    "minimum-stability": "stable"
}
