{
    "name": "danog/php-rtc-dtls",
    "type": "library",
    "description": "Pure-PHP DTLS 1.2 for WebRTC, powered by phpseclib and Amp v3.",
    "keywords": [
        "rtp",
        "dtls",
        "ssl",
        "crypto",
        "openssl",
        "x509",
        "certificate",
        "privatekey"
    ],
    "homepage": "https://github.com/danog/php-rtc-dtls",
    "license": "BSD-3-Clause",
    "authors": [
        {
            "name": "Amin Yazdanpanah",
            "email": "github@aminyazdanpanah.com"
        },
        {
            "name": "Sana Moniri",
            "email": "s.mo@quasarstream.com"
        },
        {
            "name": "Quasar Stream Community"
        },
        {
            "name": "Daniil Gentili",
            "email": "daniil@daniil.it"
        }
    ],
    "require": {
        "php": "^8.2",
        "amphp/amp": "^3.1.3",
        "danog/php-rtc-exception": "^1.1.5",
        "danog/php-rtc-ice": "^1.1.18",
        "danog/php-rtc-rtp": "^1.1.13",
        "danog/php-rtc-sctp": "^1.1.5",
        "danog/php-rtc-stats": "^1.1.3",
        "danog/php-rtc-sdp": "^1.1.6",
        "danog/php-rtc-mixin": "^1.1.6",
        "danog/php-rtc-srtp": "^1.1.7",
        "evenement/evenement": "^3.0.2",
        "symfony/polyfill-php84": ">=1.38.1",
        "phpseclib/phpseclib": "^3.0.57"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0 || ^13.3.2",
        "dg/bypass-finals": "dev-master",
        "bamarni/composer-bin-plugin": "^1.9.1"
    },
    "autoload": {
        "psr-4": {
            "Webrtc\\DTLS\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\Webrtc\\DTLS\\": "tests"
        }
    },
    "minimum-stability": "stable",
    "scripts": {
        "post-install-cmd": [
            "@composer bin all install --ansi"
        ],
        "post-update-cmd": [
            "@composer bin all update --ansi"
        ]
    },
    "config": {
        "allow-plugins": {
            "bamarni/composer-bin-plugin": true
        }
    },
    "extra": {
        "bamarni-bin": {
            "bin-links": true,
            "forward-command": true
        }
    }
}
